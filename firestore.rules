rules_version = '2';

// FirstRung is API-first: every read and write goes through the API on Cloud Run,
// which uses its own service account and is not limited by these rules.
// Browsers and apps may never read or write the database directly.
//
// Collections (written by the API):
//   users/{uid}         email, name, last_seen              (from /api/me)
//   playbooks/{id}      title, goal, steps, gotchas, ...    (from /api/capture)
//   plans/{id}          role, items, gaps, coverage_percent (from /api/plan)
//   events/{id}         plan_id, item_index, outcome, note  (from /api/session)
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
